# Base de datos (Postgres). En Neon usar la cadena "pooled".
DATABASE_URI=postgres://olcd:olcd@localhost:5432/olcd

# Clave para firmar sesiones del CMS. Generar con: openssl rand -hex 32
PAYLOAD_SECRET=

# URL pública del sitio (sin barra final). Se fija al compilar.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Almacenamiento S3-compatible (R2 / S3 en Vercel, MinIO en Docker).
# Si S3_BUCKET está vacío, los archivos se guardan en disco (sólo desarrollo).
S3_BUCKET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# URL pública del bucket (se fija al compilar: alimenta images.remotePatterns)
S3_PUBLIC_URL=http://localhost:9000/olcd
# true en Vercel (subida directa desde el navegador); false con MinIO en Docker
S3_CLIENT_UPLOADS=false

# Correo saliente (formulario de contacto). Sin SMTP_HOST no se envía correo,
# pero los mensajes quedan guardados en el admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@olcd.org
CONTACTO_DESTINO=

# Opcional: `npm run seed` crea este usuario admin si no existe ninguno.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
