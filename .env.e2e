# App de pruebas E2E (Playwright): Next dev en el host, puerto 3001, base olcd_e2e.
# Valores desechables, sin secretos reales. La base se crea con:
# docker exec olcd-test-db psql -U olcd -d olcd_test -c "CREATE DATABASE olcd_e2e OWNER olcd;"
NODE_ENV=development
DATABASE_URI=postgres://olcd:olcd@127.0.0.1:5433/olcd_e2e
PAYLOAD_SECRET=secreto-e2e-no-usar-en-produccion
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
S3_BUCKET=
S3_PUBLIC_URL=http://localhost:9000/olcd
SEED_ADMIN_EMAIL=admin@pruebas.olcd
SEED_ADMIN_PASSWORD=Pruebas-OLCD-2026!
