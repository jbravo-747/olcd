# Base de pruebas de Vitest (integración con Payload). Valores desechables, sin secretos reales.
# Postgres: docker run -d --name olcd-test-db -p 127.0.0.1:5433:5432 -e POSTGRES_USER=olcd -e POSTGRES_PASSWORD=olcd -e POSTGRES_DB=olcd_test postgres:16-alpine
NODE_ENV=test
DATABASE_URI=postgres://olcd:olcd@127.0.0.1:5433/olcd_test
PAYLOAD_SECRET=secreto-de-pruebas-no-usar-en-produccion
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
S3_BUCKET=
S3_PUBLIC_URL=http://localhost:9000/olcd
